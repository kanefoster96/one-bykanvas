# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values; never paste the secret ones into chat or a client file.

# Stripe -> Developers -> API keys (use the sandbox/test keys first)
STRIPE_SECRET_KEY=sk_test_...

# The signing secret from the endpoint you add for /api/stripe-webhook.
#
# Stripe has moved this and no longer always calls it "webhooks": it is either
# the Webhooks tab inside Developers -> Workbench, or Settings -> Developers ->
# Event destinations. https://dashboard.stripe.com/test/webhooks goes straight
# there. A sandbox is its own account context, so add the endpoint with the
# sandbox selected or it will never fire for sandbox payments.
#
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted,
#         invoice.payment_failed
#
# THE URL MUST NOT REDIRECT. Stripe does not follow redirects: a 308 counts as
# a failed delivery and the event is never seen. If both kanvas.one and
# www.kanvas.one are on the project, one of them 308s to the other, and only
# the one Vercel -> Settings -> Domains lists WITHOUT "Redirect to" will work.
# Every delivery failing with 308 and nothing at all in the Vercel logs is this,
# every time - the request never reaches the function.
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase -> Project Settings -> API
SUPABASE_URL=https://djhygbmuvacbpbnisuwd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase -> Project Settings -> API -> service_role. SERVER ONLY.
# This bypasses row level security. It must never appear in any file the
# browser downloads.
SUPABASE_SERVICE_ROLE_KEY=...

# The domain used for checkout return URLs and every link in the emails we
# send. Set it to the canonical custom domain: the .vercel.app address sits
# behind Vercel Authentication, so leaving this unset points customers at a
# login wall they cannot get through.
SITE_URL=https://kanvas.one

# Resend, for the mail we send ourselves - currently the new customer alert.
# Leave unset and nothing is sent and nothing breaks.
#
# This is NOT what sends the confirmation and password reset emails. Those come
# from Supabase, and pointing them at Resend is a dashboard job: Authentication
# -> Emails -> SMTP Settings, host smtp.resend.com, port 465, username "resend",
# password the same API key. Until that is done Supabase uses its own mail
# service, which allows only a couple of sends an hour.
RESEND_API_KEY=re_...

# Must be a domain verified in Resend, or Resend refuses the send.
EMAIL_FROM=one by Kanvas <hello@yourdomain.co.uk>

# Who gets the new customer alert, and who may open /admin. Comma separated.
ADMIN_EMAILS=kane@kanvas.one
