{
  "expo": {
    "name": "Kanvas One",
    "slug": "kanvas-one",
    "version": "1.0.0",
    "scheme": "kanvasone",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "primaryColor": "#1d1d1f",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2d7868d0-929f-451a-8796-82681204f0f8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "one.kanvas.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:kanvas.one"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "So you can scan QR codes at the door, and take a photo to send with a request or a message.",
        "NSPhotoLibraryUsageDescription": "So you can attach photos to a request or a message.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "So you can add a booking to your calendar.",
        "NSCalendarsUsageDescription": "So you can add a booking to your calendar.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "one.kanvas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08080a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kanvas.one",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c93e09",
          "defaultChannel": "one"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "So you can scan QR codes at the door, and take a photo to send with a request or a message.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "So you can add a booking to your calendar."
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "2d7868d0-929f-451a-8796-82681204f0f8"
      }
    },
    "owner": "kanefoster96"
  }
}
